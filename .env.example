# Copy to .env and fill in. .env is gitignored — keep it that way.
#
#   cp .env.example .env
#
# Never commit real values. Never paste a key in Telegram, in an issue, or in a
# screenshot. If you leak one, say so immediately and we rotate it — that costs
# five minutes; a key that quietly stays leaked costs a lot more.

# Your team's key, from the Anthropic Console workspace for your team.
ANTHROPIC_API_KEY=

# From @BotFather on Telegram. This is a password.
TELEGRAM_BOT_TOKEN=

# --- optional overrides ----------------------------------------------------
# NEST_ANSWER_MODEL=claude-opus-5-5
# NEST_JUDGE_MODEL=claude-sonnet-5-5
# NEST_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# NEST_K=5
# NEST_DATA_DIR=./data
