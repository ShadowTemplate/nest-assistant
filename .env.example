# Copy to .env and fill in. .env is gitignored — keep it that way.
#
#   cp .env.example .env
#
# Never commit real values. Never paste a key in Telegram, in an issue, or in a
# screenshot. If you leak one, say so immediately and we rotate it — that costs
# five minutes; a key that quietly stays leaked costs a lot more.

# Your team's key, from the Anthropic Console workspace for your team.
ANTHROPIC_API_KEY=

# From @BotFather on Telegram. This is a password.
TELEGRAM_BOT_TOKEN=

# While testing, the bot answers only the Telegram ids in data/bot_testers.json.
# Create it yourself, on your machine — it holds real people and is never committed:
#   {"telegram:111111111": "Nome Cognome"}
# (a refused user's id shows up in data/logs/_RIFIUTATI/ — add it after you have
# checked whose it is). Set NEST_BOT_OPEN to 1 to lift the limit and answer
# everybody. Anything else keeps it closed.
NEST_BOT_OPEN=0

# --- optional overrides ----------------------------------------------------
# NEST_ANSWER_MODEL=claude-sonnet-5-5
# NEST_JUDGE_MODEL=claude-opus-5-5
# NEST_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# NEST_K=5
# NEST_DATA_DIR=./data
